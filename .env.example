# 교사 방 생성용 비밀키: 16자 이상의 임의 문자열. 학생에게 공유하지 마세요.
# pnpm local 은 .env가 없으면 안전한 임의 키를 자동 생성합니다.
TEACHER_KEY=replace-with-a-long-random-secret
PORT=3000
HOST=0.0.0.0
# 배포 시 실제 HTTPS 주소. 로컬 테스트에서는 비워둡니다.
PUBLIC_ORIGIN=
# 교실 저장 폴더. 서버를 다시 켤 때도 같은 경로를 사용하세요. Git에 올리지 않습니다.
DATA_DIR=data/classes
# 테스트 기간에만 false: 학생24시간 접속 허용. 정식 운영 전 true로 복원하고 서버 재시작.
STUDENT_HOURS=true
# 비밀 조합법 파일. Git에 포함되지 않으므로 다른 PC로 이전할 때 안전하게 복사하세요.
CRAFTING_RECIPES_FILE=data/crafting-recipes.json
