{
  "name": "cyber-classroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "local": "node scripts/local.mjs",
    "test:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "socket.io-client": "^4.8.1"
  },
  "packageManager": "pnpm@11.19.0"
}
